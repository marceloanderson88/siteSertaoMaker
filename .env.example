# Public pages use the initial news when storage is not configured.
# Create a PRIVATE Vercel Blob store and connect it to production/development.
BLOB_READ_WRITE_TOKEN=
ADMIN_EMAIL=
# Versioned scrypt hash (N=131072, r=8, p=1), generated by scripts/setup-admin.mjs
ADMIN_PASSWORD_HASH_V2=
# At least 32 random characters. Never expose this as NEXT_PUBLIC_*.
ADMIN_SESSION_SECRET=
